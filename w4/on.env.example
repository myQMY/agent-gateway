# 复制为 w4/on.env。本文件不含真实密钥，可安全入库。
# P1 的 eval.run 只读 --env-file 指定的这个文件，不读 export 的环境变量。
# 经网关：LLM_BASE_URL 必须带 /v1 —— P1 自拼 /chat/completions，
# 网关只注册 /v1/chat/completions。
# LLM_API_KEY 只需非空占位：网关不校验 Authorization 头，但 P1 要求三键齐全。
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=placeholder
LLM_MODEL=deepseek-flash
