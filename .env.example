# W1 默认不接真实供应商；以下键留空也能跑完全部回放基准。
# 键名与用途如实标注，不把 W2/W4 的可选项写成 W1 必需项。

# 本地服务监听（仅 HTTP 层需要）
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000

# 回放基准默认值（也可全部用 CLI 参数覆盖）
GATEWAY_SEED=11
GATEWAY_N=600

# W2 起可选：真实供应商适配器。切勿提交真实 key，.env 已被 .gitignore 排除。
# 默认关闭（GATEWAY_REAL_UPSTREAM 未设置时一律走确定性 fake，零 API 成本）。
# 它不进任何回放基准、不改 config_hash、不写进归档；启用需自己的密钥与预算。
# GATEWAY_REAL_UPSTREAM=0
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# GATEWAY_API_KEY_ENV=LLM_API_KEY
# GATEWAY_UPSTREAM_PATH=/chat/completions
# GATEWAY_UPSTREAM_TIMEOUT=10
